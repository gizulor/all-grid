<article class="u_gutter u_flow <txp:yield name="article_class" />" itemscope itemtype="http://schema.org/CreativeWork">
  <txp::u_debug title='form: default' />
  <meta itemprop="mainEntityOfPage" content="<txp:permlink />">

    <header<txp:evaluate> class="<txp:yield name="article_header" />"</txp:evaluate>>
    <h1 itemprop="headline"<txp:evaluate> class="<txp:yield name="article_headline" />"</txp:evaluate>>
      <txp:title />
      <txp::u_edit />
    </h1>
    <txp:evaluate>
      <aside itemprop="description" class="b_typeset b_typeset--lede <txp:yield name="article_description" />">
        <txp:excerpt />
      </aside>
    </txp:evaluate>
    <txp:hide>
      <txp::m_posted />
    </txp:hide>
    <txp::m_menuCategories_article class="b_typeset" />
  </header>
   <txp:if_article_image>
    <txp::figure limit="1" lightbox class="a_image--fold-limited hero" />
  </txp:if_article_image>

    <txp:evaluate>
      <div itemprop="articleBody" class="b_typeset <txp:yield name="article_copy" />">
        <txp:body />
      </div>
    </txp:evaluate>

  <txp::m_embed controls class="u_span--full-width" />

  <txp:if_article_image>
    <txp::gallery tri id='<txp:custom_field name="article_image" />' offset="1" limit="50"  gallery_class="u_span--full-width" />
  </txp:if_article_image>

</article>