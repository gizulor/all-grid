<article class="l_superimposed <txp:yield name="article_class" /> u_span--full-width" itemscope itemtype="http://schema.org/CreativeWork">

  <meta itemprop="mainEntityOfPage" content="<txp:permlink />">
    <txp::u_debug title='form: super' />

    <txp:if_article_image>
      <txp::figure id='<txp:custom_field name="article_image" />' sort="rand()" limit="1" nocaption class='<txp:yield name="article_figure" />'/>
      <txp:else />
      <p class="bg--surface u_tallface l_column middle">At least one article image is required</p>
    </txp:if_article_image>

    <div class="l_superimposed__inner <txp:yield name="article_inner" />">

      <h1 itemprop="headline" class="h0-style <txp:yield name="article_headline" />"><txp:title /><txp::u_edit /></h1>

      <txp:evaluate>
        <aside itemprop="description" class="b_typeset b_typeset--lede <txp:yield name="article_description" />"><txp:excerpt /></aside>
      </txp:evaluate>

    </div>

</article>

<txp:evaluate>
  <div itemprop="articleBody" class="b_typeset u_flow u_gutter <txp:yield name="article_copy" />"><txp:body /></div>
</txp:evaluate>


<txp::m_embed controls class="u_span--full-width" />

