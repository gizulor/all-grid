<txp:hide>
  o_header — site header: brand, nav, and anything you put inside the tag.
  The look is all CSS (scss/4-organisms/_o_header.scss): pick switches with class="".
  The debug toolbar's Header panel flips them live and copies the tag for you.

  <txp::o_header />                                      split, inline menu
  <txp::o_header class="o_header--split o_header--sticky o_header--shrink" />
  <txp::o_header class="o_header--over o_header--sticky o_header--solidify" menu="overlay" />
  <txp::o_header menu="overlay" inline="medium" />       overlay on phones, inline from medium up
  <txp::o_header nav="0" />                              no nav (use <txp::o_nav class="o_nav--sticky" /> below)
  <txp::o_header>search, language…</txp::o_header>       contents go in the extra slot

  Arrangements (--split --inline --stacked --centred) also come as @small @medium @desktop,
  meaning "from that width up" (720 / 960 / 1280px). Base class for phones, @ class to switch:
  <txp::o_header class="o_header--stacked o_header--split@small" />    nav below the logo on phones, right from 720px
  <txp::o_header class="o_header--centred o_header--split@medium" />   all centred on phones, split from 960px
  <txp::o_header class="o_header--stacked o_header--inline@desktop" /> nav below until 1280px, then beside the brand

  class       switches, default "o_header--split"; arrangements take @small @medium @desktop
  style       knobs, e.g. style="--o-header-name: var(--h1)"
  sitename    replaces the site name; also takes a logo: sitename='<txp:output_form form="logo" />'
  slogan="0"  hides the slogan
  nav="0"     no nav
  menu, inline, sections, exclude, label, id   passed on to o_nav (see that form)
</txp:hide>
<header class="o_header <txp:yield trim name="class"  default="o_header--split" />"<txp:if_yield name="style"> style="<txp:yield name="style" />"</txp:if_yield>>
  <a class="o_header__brand" rel="home" href="<txp:site_url />">
    <span class="o_header__name"><txp:yield name="sitename" default='<txp:site_name />' /></span>
    <txp:if_yield name="slogan" value="0"><txp:else /><span class="o_header__slogan"><txp:site_slogan /></span></txp:if_yield>
  </a>

  <txp:if_yield name="nav" value="0"><txp:else />
    <txp::o_nav class="o_header__nav" menu='<txp:yield name="menu" default="inline" />' inline='<txp:yield name="inline" />' sections='<txp:yield name="sections" />' exclude='<txp:yield name="exclude" default="home" />' label='<txp:yield name="label" default="Menu" />' id='<txp:yield name="id" default="main" />' />
  </txp:if_yield>

  <txp:if_yield><div class="o_header__extra"><txp:yield /></div></txp:if_yield>
</header>
<txp:if_variable name="o_header_js" value="1"><txp:else /><txp:variable name="o_header_js" value="1" />
<script src="<txp:page_url type="theme_path" />/js/o_header.js?v=<txp:variable name="cache-buster" />" defer></script>
</txp:if_variable>
