<!DOCTYPE html>
<html lang="<txp:lang />" dir="<txp:text item="lang_dir" />">

<txp:output_form form="head" />

<txp::u_debug breakpoints toggle title='page: <txp:page_url type="page" />' />

<txp::o_header_common />

<main aria-label="<txp:text item="main_content" />" itemscope <txp::a_itemtype />>

  <txp:if_individual_article>
    <txp::o_pagination section class="u_gutter u_tallface h5-style l_width-limited l_width-limited--large l_beam middlev right" />
  </txp:if_individual_article>

  <txp:if_article_list>

      <txp:article status="sticky" form="super" limit="1" />

      <txp:article listform="thumb_super" allowoverride="0" wraptag="ul" limit="36" class="u_gutter a_list-bare l_width-limited l_width-limited--large l_grid l_grid--auto l_gap--large@medium" />

  <txp:else />
    <txp::with
      article_class="u_gutter l_width-limited l_width-limited--large l_grid l_grid--twin@medium l_gap--large@medium"
      article_header="l_column middlev"
      article_headline="h0-style"
      article_copy="u_span--full-width l_width-limited u_tallface"
    >
      <txp:article />
    </txp::with>
  </txp:if_article_list>

</main>

<txp::o_footer class="u_gutter" />
<txp::o_javascript />

</body>

</html>